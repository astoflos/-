{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/minimal", "destination": "/minimal/index.html" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "minimal.eden-guild.top" }],
      "destination": "/minimal/index.html"
    }
  ]
}
